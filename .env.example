# API keys (only needed for pre-computation, NOT for ranking)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Embedding model (local, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Paths
CANDIDATES_PATH=./[PUB] India_runs_data_and_ai_challenge/India_runs_data_and_ai_challenge/candidates.jsonl
ARTIFACTS_DIR=./artifacts
OUTPUT_PATH=./submission.csv

# Scoring weights (tunable)
WEIGHT_SEMANTIC=0.25
WEIGHT_CAREER=0.30
WEIGHT_SKILL=0.20
WEIGHT_BEHAVIORAL=0.15
WEIGHT_EDUCATION=0.10
